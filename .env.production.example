# =============================================================================
# HeroPips — PRODUCTION environment
#   cp .env.production.example .env.production   # render from your secret store
# =============================================================================
# This file must never exist in the repository with real values. Render it at
# deploy time from a secret manager (SOPS, Vault, AWS Secrets Manager, Doppler);
# `.env*` is gitignored, but the only durable protection is not writing secrets
# to disk in the first place.
#
# `pnpm preflight:production` refuses to start when it finds a development
# placeholder, a non-https origin, a short secret, or EARLY_ACCESS_DEV_CODE.
#
# ROTATION
#   STATUS_TOKEN_SECRET   invalidates outstanding order-status links
#   ADMIN_TOKEN           rotate on any team change
#   NOWPAYMENTS_*         rotate in the provider dashboard first, then here
#   CRED_KEY              CANNOT be rotated without re-encrypting every stored
#                         broker credential. See the runbook before touching it.
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=heropips-prod
RESTART_POLICY=always

# ---- images -----------------------------------------------------------------
# Built once in CI, pulled here. An immutable tag is what makes a rollback a
# one-line change instead of an archaeology exercise.
IMAGE_REGISTRY=<registry-host>/heropips
IMAGE_TAG=<git-sha>
PULL_POLICY=always

# ---- edge -------------------------------------------------------------------
SITE_DOMAIN=heropips.com
ACME_EMAIL=ops@heropips.com

# ---- data plane -------------------------------------------------------------
# Strongly prefer a managed Postgres and a managed Kafka. To use them, point
# the URLs below at the managed endpoints and start the stack with
# `--scale postgres=0 --scale kafka=0`.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=heropips_app
POSTGRES_PASSWORD=<openssl rand -base64 32>
POSTGRES_DB=hp
PG_CPU_LIMIT=4.0
PG_MEM_LIMIT=4G
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_MAINTENANCE_WORK_MEM=256MB
PG_MAX_WAL_SIZE=4GB
PG_LOG_MIN_DURATION_MS=1000
PG_BACKUP_DIR=/var/backups/heropips

KAFKA_BROKERS=kafka:9092
KAFKA_CPU_LIMIT=2.0
KAFKA_MEM_LIMIT=2G
KAFKA_RETENTION_HOURS=336
KAFKA_NUM_PARTITIONS=3

DATABASE_URL_IDENTITY=postgres://heropips_app:<password>@postgres:5432/hp_identity
DATABASE_URL_BILLING=postgres://heropips_app:<password>@postgres:5432/hp_billing
DATABASE_URL_GROWTH=postgres://heropips_app:<password>@postgres:5432/hp_growth
DATABASE_URL_SIGNAL=postgres://heropips_app:<password>@postgres:5432/hp_signal
DATABASE_URL_TRADING=postgres://heropips_app:<password>@postgres:5432/hp_trading

# ---- resource limits --------------------------------------------------------
SVC_CPU_LIMIT=1.0
SVC_MEM_LIMIT=768M
SVC_MEM_RESERVE=256M
WEB_CPU_LIMIT=2.0
WEB_MEM_LIMIT=1G

# ---- public surface ---------------------------------------------------------
# Compiled into the client bundle. A change here means a rebuild and a new
# IMAGE_TAG; restarting the container will not pick it up.
NEXT_PUBLIC_SITE_URL=https://heropips.com
NEXT_PUBLIC_CHAT_WS_URL=wss://heropips.com/v1/chat/ws
NEXT_PUBLIC_LAUNCH_MODE=main
PUBLIC_ORIGIN=https://heropips.com

# ---- edge topology / rate limiting ------------------------------------------
# Caddy terminates TLS and is the ONLY hop in front of web, so the right-most
# x-forwarded-for entry is the real client. Add a CDN/ELB in front and bump
# this to match, or the BFF limiter buckets every request onto that proxy's
# address. preflight requires >= 1 here and REFUSES RATE_LIMIT_DISABLED.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_DISABLED=false
# Placeholder secrets are refused outright here; preflight fails if this is on.
ALLOW_DEV_SECRETS=false

# ---- service-to-service -----------------------------------------------------
GROWTH_URL_INTERNAL=http://growth:4001
BILLING_URL_INTERNAL=http://billing:4002
IDENTITY_URL_INTERNAL=http://identity:4003
SIGNAL_URL_INTERNAL=http://signal:4004
TRADING_URL_INTERNAL=http://trading:4005
GROWTH_URL=http://growth:4001
BILLING_URL=http://billing:4002
IDENTITY_URL=http://identity:4003
SIGNAL_URL=http://signal:4004
TRADING_URL=http://trading:4005

# ---- billing (LIVE MONEY) ---------------------------------------------------
NOWPAYMENTS_API_URL=https://api.nowpayments.io
NOWPAYMENTS_API_KEY=<live api key>
# The IPN HMAC secret. Anyone holding it can forge a "paid" callback and mint
# free lifetime seats. Treat it exactly like a payment credential.
NOWPAYMENTS_IPN_SECRET=<live ipn secret>
IPN_CALLBACK_URL=https://heropips.com/v1/billing/ipn
LTD_PRICE_USD=499
LTD_SEAT_CAP=500
STATUS_TOKEN_SECRET=<openssl rand -base64 32>

# ---- identity ---------------------------------------------------------------
# Every code here is a free lifetime account. Normally empty in production.
EARLY_ACCESS_CODES=

# ---- trading ----------------------------------------------------------------
# AES-256-GCM master key for broker credentials at rest.
# Back it up before the first live connection: losing it means every stored
# credential is permanently undecryptable.
CRED_KEY=<openssl rand -hex 32>
MARK_INTERVAL_SEC=30

# ---- signal -----------------------------------------------------------------
SIGNAL_SOURCE=binance
SIGNAL_INTERVAL_SEC=60

# ---- growth / lifecycle email ----------------------------------------------
SMTP_URL=smtp://<user>:<password>@<smtp-host>:587
EMAIL_FROM="HeroPips <hello@heropips.com>"
EMAIL_REPLY_TO=support@heropips.com
ADMIN_NOTIFY_EMAIL=ops@heropips.com
MESSAGING_ENABLED=true
MESSAGING_SWEEP_INTERVAL_SEC=60
ADMIN_TOKEN=<openssl rand -base64 32>
# EARLY_ACCESS_DEV_CODE must NOT appear in this file at all.

# ---- analytics --------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=<G-XXXXXXXXXX>
NEXT_PUBLIC_CLARITY_ID=<clarity project id>
GA4_MEASUREMENT_ID=<G-XXXXXXXXXX>
GA4_API_SECRET=<measurement protocol api secret>

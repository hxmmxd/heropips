# =============================================================================
# HeroPips — LOCAL environment
#   cp .env.local.example .env.local
# =============================================================================
# Every value here is a safe development placeholder. Nothing in this file is
# a secret, and preflight deliberately skips the placeholder scan for `local`.
#
# Docker Compose reads this via `--env-file`; the same file also feeds
# `scripts/db.mjs` and `scripts/preflight.mjs`, so there is one env source per
# environment rather than one per tool.
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=heropips
RESTART_POLICY=no

# ---- data plane -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hp
POSTGRES_PASSWORD=hp
POSTGRES_DB=hp
KAFKA_BROKERS=kafka:9092
KAFKA_EXTERNAL_HOST=localhost

# Per-service databases. Host `postgres` resolves inside the compose network;
# scripts/db.mjs rewrites it automatically when talking from the host.
DATABASE_URL_IDENTITY=postgres://hp:hp@postgres:5432/hp_identity
DATABASE_URL_BILLING=postgres://hp:hp@postgres:5432/hp_billing
DATABASE_URL_GROWTH=postgres://hp:hp@postgres:5432/hp_growth
DATABASE_URL_SIGNAL=postgres://hp:hp@postgres:5432/hp_signal
DATABASE_URL_TRADING=postgres://hp:hp@postgres:5432/hp_trading

# ---- public surface ---------------------------------------------------------
# NEXT_PUBLIC_* are inlined at BUILD time. Changing one requires a rebuild.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:4003/v1/chat/ws
NEXT_PUBLIC_LAUNCH_MODE=prelaunch
PUBLIC_ORIGIN=http://localhost:3000

# ---- edge topology / rate limiting ------------------------------------------
# The local stack publishes web:3000 directly, so there is NO proxy in front:
# every request arrives from the same address, which would collapse the BFF
# limiter into one global bucket shared by all callers. A global bucket is
# worse than none (it is how identity's loginByIp became a platform-wide
# 10/min cap), so the limiter stands down here instead of pretending.
#
# The limiter's behaviour is covered by apps/web/app/api/_lib/rate-limit.test.ts;
# the e2e suite shares one loopback address and would otherwise 429 on its own
# traffic. preflight BLOCKS this flag for staging and production, where Caddy
# terminates TLS and TRUSTED_PROXY_HOPS=1 gives a real per-client key.
RATE_LIMIT_DISABLED=true
TRUSTED_PROXY_HOPS=1

# The three billing secrets below are the placeholders published in this repo.
# Services refuse to boot on them unless this flag says the stack is local;
# preflight BLOCKS the flag for staging and production.
ALLOW_DEV_SECRETS=true

# ---- service-to-service (compose DNS names) ---------------------------------
GROWTH_URL_INTERNAL=http://growth:4001
BILLING_URL_INTERNAL=http://billing:4002
IDENTITY_URL_INTERNAL=http://identity:4003
SIGNAL_URL_INTERNAL=http://signal:4004
TRADING_URL_INTERNAL=http://trading:4005
# Consumed by scripts/preflight.mjs, which validates the host-side view.
GROWTH_URL=http://localhost:4001
BILLING_URL=http://localhost:4002
IDENTITY_URL=http://localhost:4003
SIGNAL_URL=http://localhost:4004
TRADING_URL=http://localhost:4005

# ---- billing ----------------------------------------------------------------
# Points at the in-stack mock, which signs IPNs with NOWPAYMENTS_IPN_SECRET.
NOWPAYMENTS_API_URL=http://nowpayments-mock:4090
NOWPAYMENTS_API_KEY=sandbox-key
NOWPAYMENTS_IPN_SECRET=dev-ipn-secret
IPN_CALLBACK_URL=http://billing:4002/v1/billing/ipn
LTD_PRICE_USD=499
LTD_SEAT_CAP=500
STATUS_TOKEN_SECRET=dev-status-secret-change-me

# ---- identity ---------------------------------------------------------------
# Bypass codes for /app/redeem without completing a purchase.
EARLY_ACCESS_CODES=hp_dev_alpha,hp_dev_beta

# ---- trading ----------------------------------------------------------------
# AES-256-GCM key for broker credentials at rest. Generate: openssl rand -hex 32
# secret-scan:allow — documented local placeholder
CRED_KEY=6b65796465763031323334353637383961626364656630313233343536373839
MARK_INTERVAL_SEC=30

# ---- signal -----------------------------------------------------------------
# sim = deterministic, offline, reproducible. binance = public REST, crypto only.
SIGNAL_SOURCE=sim
SIM_SEED=42
SIGNAL_INTERVAL_SEC=30

# ---- growth / lifecycle email ----------------------------------------------
# Mailpit captures everything; nothing leaves the machine. UI: http://localhost:8025
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM="HeroPips <hello@heropips.local>"
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=ops@heropips.local
MESSAGING_ENABLED=true
MESSAGING_SWEEP_INTERVAL_SEC=15
# Fixes EVERY early-access code to this value and echoes it in the API response
# so QA never needs an inbox. Preflight blocks this beyond local.
EARLY_ACCESS_DEV_CODE=123456
# Guards PATCH /v1/referrals/config. Unset ⇒ admin mutations return 503.
ADMIN_TOKEN=dev-admin-token

# ---- analytics (optional; every feature no-ops when unset) -----------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# =============================================================================
# HeroPips — STAGING environment
#   cp .env.staging.example .env.staging   # then fill every <...> placeholder
# =============================================================================
# .env.staging is NOT committed. Generate real values, store them in your
# secret manager, and render this file at deploy time.
#
# `pnpm preflight:staging` blocks the stack if any development placeholder,
# localhost origin or plaintext http:// origin survives into this file.
#
# Generate secrets:
#   openssl rand -base64 32        # STATUS_TOKEN_SECRET, ADMIN_TOKEN, passwords
#   openssl rand -hex 32           # CRED_KEY (must be exactly 64 hex chars)
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<pw>'
# =============================================================================

NODE_ENV=production
COMPOSE_PROJECT_NAME=heropips-staging
RESTART_POLICY=unless-stopped

# ---- images -----------------------------------------------------------------
# Immutable tag from CI. Never "latest": a rollback must be reproducible.
IMAGE_REGISTRY=<registry-host>/heropips
IMAGE_TAG=<git-sha>
PULL_POLICY=always

# ---- edge -------------------------------------------------------------------
SITE_DOMAIN=staging.heropips.com
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
STAGING_BASICAUTH_USER=heropips
STAGING_BASICAUTH_HASH=<output of `caddy hash-password`>

# ---- data plane -------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=heropips_app
POSTGRES_PASSWORD=<openssl rand -base64 32>
POSTGRES_DB=hp
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=512MB
PG_LOG_MIN_DURATION_MS=200

KAFKA_BROKERS=kafka:9092
KAFKA_RETENTION_HOURS=72

DATABASE_URL_IDENTITY=postgres://heropips_app:<password>@postgres:5432/hp_identity
DATABASE_URL_BILLING=postgres://heropips_app:<password>@postgres:5432/hp_billing
DATABASE_URL_GROWTH=postgres://heropips_app:<password>@postgres:5432/hp_growth
DATABASE_URL_SIGNAL=postgres://heropips_app:<password>@postgres:5432/hp_signal
DATABASE_URL_TRADING=postgres://heropips_app:<password>@postgres:5432/hp_trading

# ---- public surface ---------------------------------------------------------
# Baked into the client bundle at image build time. Changing these requires a
# rebuild and a new IMAGE_TAG — a restart alone will not pick them up.
NEXT_PUBLIC_SITE_URL=https://staging.heropips.com
NEXT_PUBLIC_CHAT_WS_URL=wss://staging.heropips.com/v1/chat/ws
NEXT_PUBLIC_LAUNCH_MODE=prelaunch
PUBLIC_ORIGIN=https://staging.heropips.com

# ---- edge topology / rate limiting ------------------------------------------
# Caddy terminates TLS and is the ONLY hop in front of web, so the right-most
# x-forwarded-for entry is the real client. Add a CDN/ELB in front and bump
# this to match, or the BFF limiter buckets every request onto that proxy's
# address. preflight requires >= 1 here and REFUSES RATE_LIMIT_DISABLED.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_DISABLED=false
# Placeholder secrets are refused outright here; preflight fails if this is on.
ALLOW_DEV_SECRETS=false

# ---- service-to-service -----------------------------------------------------
GROWTH_URL_INTERNAL=http://growth:4001
BILLING_URL_INTERNAL=http://billing:4002
IDENTITY_URL_INTERNAL=http://identity:4003
SIGNAL_URL_INTERNAL=http://signal:4004
TRADING_URL_INTERNAL=http://trading:4005
GROWTH_URL=http://growth:4001
BILLING_URL=http://billing:4002
IDENTITY_URL=http://identity:4003
SIGNAL_URL=http://signal:4004
TRADING_URL=http://trading:4005

# ---- billing ----------------------------------------------------------------
# NOWPayments sandbox — real API shape, no real money.
NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io
NOWPAYMENTS_API_KEY=<sandbox api key>
NOWPAYMENTS_IPN_SECRET=<sandbox ipn secret from the NOWPayments dashboard>
# Must be publicly reachable — the provider calls it from the internet.
IPN_CALLBACK_URL=https://staging.heropips.com/v1/billing/ipn
LTD_PRICE_USD=499
LTD_SEAT_CAP=500
STATUS_TOKEN_SECRET=<openssl rand -base64 32>

# ---- identity ---------------------------------------------------------------
# Comma-separated codes that redeem without a purchase. Keep this short-lived
# and rotate it: each code is a free lifetime account.
EARLY_ACCESS_CODES=<rotate-per-test-cycle>

# ---- trading ----------------------------------------------------------------
# Losing this key makes every stored broker credential undecryptable. Back it
# up in the secret manager BEFORE the first live connection is created.
CRED_KEY=<openssl rand -hex 32>
MARK_INTERVAL_SEC=30

# ---- signal -----------------------------------------------------------------
SIGNAL_SOURCE=sim
SIM_SEED=42
SIGNAL_INTERVAL_SEC=60

# ---- growth / lifecycle email ----------------------------------------------
# A real SMTP provider: staging mail reaches real inboxes. Keep the recipient
# set to the team and never restore a production contact export here.
SMTP_URL=smtp://<user>:<password>@<smtp-host>:587
EMAIL_FROM="HeroPips Staging <staging@heropips.com>"
EMAIL_REPLY_TO=support@heropips.com
ADMIN_NOTIFY_EMAIL=ops@heropips.com
MESSAGING_ENABLED=true
MESSAGING_SWEEP_INTERVAL_SEC=60
ADMIN_TOKEN=<openssl rand -base64 32>
# EARLY_ACCESS_DEV_CODE must stay unset — preflight fails staging if it is set.

# ---- analytics --------------------------------------------------------------
# Leave empty on staging so test traffic never pollutes production analytics.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# ---- web ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# academy + CTA gating: prelaunch | main
NEXT_PUBLIC_LAUNCH_MODE=prelaunch
GROWTH_URL=http://localhost:4001
BILLING_URL=http://localhost:4002
# ---- analytics (all optional; features no-op when unset) ----
# GA4 web stream id, e.g. G-XXXXXXXXXX (free: analytics.google.com)
NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity project id (free heatmaps/session replay: clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=
# ---- services ----
DATABASE_URL_GROWTH=postgres://hp:hp@localhost:5432/hp_growth
DATABASE_URL_BILLING=postgres://hp:hp@localhost:5432/hp_billing
KAFKA_BROKERS=localhost:9092
# ---- NOWPayments (sandbox) ----
NOWPAYMENTS_API_URL=http://localhost:4090
NOWPAYMENTS_API_KEY=sandbox-key
NOWPAYMENTS_IPN_SECRET=dev-ipn-secret
PUBLIC_ORIGIN=http://localhost:3000
LTD_PRICE_USD=499
LTD_SEAT_CAP=500
STATUS_TOKEN_SECRET=dev-status-secret-change-me
# ---- founding seat holds (billing-svc) ----
# Minutes a seat stays reserved for an unpaid order. Defaults to
# contracts LTD.HOLD_TTL_MINUTES (20). Only holds with NO payment in flight are
# ever reclaimed, so a slow chain never costs a paying buyer their seat.
LTD_HOLD_TTL_MINUTES=20
# Concurrent held orders allowed per email / per client IP.
LTD_MAX_HOLDS_PER_EMAIL=2
LTD_MAX_HOLDS_PER_IP=5
# true ⇒ checkout requires a growth-issued verified-email token
# (x-hp-verify-token header or verify_token in the body). Off by default:
# gating a live paid funnel on email verification is a conversion decision.
LTD_REQUIRE_VERIFIED_CHECKOUT=false
# ---- internal service auth (growth-svc) ----
# Shared bearer the web BFF must send as `x-hp-internal-token` on every
# /v1/academy/** and /v1/referrals/** call. growth-svc REFUSES TO BOOT without
# it when NODE_ENV=production: those routes take the acting user from the
# request body, so the caller is what has to be trusted (audit H4).
INTERNAL_SVC_TOKEN=dev-internal-svc-token
# ---- lifecycle email (growth-svc messaging engine) ----
# Any SMTP endpoint. Dev: Mailpit from docker-compose (UI at :8025).
# Prod free tiers that speak SMTP: Brevo (300/day), Resend, Mailgun trial, SES.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="HeroPips <hello@heropips.local>"
EMAIL_REPLY_TO=
PUBLIC_ORIGIN=http://localhost:3000
# GA4 Measurement Protocol for server-side email_sent/open/click events:
# admin > data streams > Measurement Protocol API secrets
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
# journey sweeper cadence (seconds); MESSAGING_ENABLED=false disables consumer+scheduler
MESSAGING_SWEEP_INTERVAL_SEC=60
MESSAGING_ENABLED=true
# ---- early access signup (growth-svc) ----
# Operational notice on every verified signup. Unset ⇒ no admin mail is sent.
ADMIN_NOTIFY_EMAIL=ops@heropips.local
# Fixed verification code for dev/staging so QA never needs an inbox.
# Opt-in: leave UNSET in production — when set, every code is this value and it
# is echoed to the caller. Setting it with NODE_ENV=production logs a warning.
EARLY_ACCESS_DEV_CODE=123456

# Gemini API Key (Required for live generation)
GEMINI_API_KEY=""

# Google API Key fallback
GOOGLE_API_KEY=""

# Gemini Model
GEMINI_MODEL="gemini-2.5-flash"

# Batch Pipeline Concurrency
PIPELINE_CONCURRENCY=2

# Maximum refinement attempts per topic
PIPELINE_MAX_RETRIES=3

# Throttle Delay Between Requests in Milliseconds
REQUEST_DELAY_MS=1500

# Mock LLM for Offline Testing (true/false)
MOCK_LLM=false

# Source topics file path
TOPICS_FILE_PATH="data/seo_50_blog_topics.md"

# Output directory for approved posts
OUTPUT_DIR="output"

# Evaluation audit directory
EVAL_DIR=".evaluations"
